# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# Путь к файлу SQLite. Локально — ./data/bot.db, на Fly.io — путь на volume, например /data/bot.db
DATABASE_PATH=./data/bot.db

# Telegram user_id админов через запятую (узнать свой id можно у @userinfobot)
ADMIN_IDS=123456789

# Часовой пояс: расписания и границы недель. Астана — Asia/Almaty (UTC+5; Asia/Astana тоже примется)
TIMEZONE=Asia/Almaty

# Еженедельный чек-ин: день (mon..sun) и время
CHECKIN_DAY=sun
CHECKIN_TIME=18:00
# Напоминание о старте недели по понедельникам (с подсказкой про буфер)
PLANNING_TIME=09:00

# Ночной бэкап: файл базы уходит документом всем ADMIN_IDS
BACKUP_TIME=03:00

# Mini App. На Fly адрес определяется сам (https://<app>.fly.dev). Локально — HTTPS-туннель
# (ngrok / cloudflared), например WEBAPP_URL=https://xxxx.ngrok-free.app
WEBAPP_URL=
PORT=8080
